GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Transient provider errors are retried by the SDK with bounded backoff (retries + 1 attempts).
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

DATABASE_URL=sqlite:///./data/ckea.db

SOURCE_DIR=./data/sources
PROTOCOL_DIR=./data/protocols
CHROMA_DIR=./data/chroma
OUTPUT_DIR=./data/output

EXTRACTION_CONFIDENCE_THRESHOLD=0.70
COMPARISON_CONFIDENCE_THRESHOLD=0.70
PROTOCOL_SIMILARITY_THRESHOLD=0.70

# Web retrieval: web pages go through Jina Reader only; PDFs are downloaded directly.
JINA_API_KEY=
JINA_READER_BASE_URL=https://r.jina.ai
JINA_TIMEOUT_SECONDS=45
URL_PROBE_TIMEOUT_SECONDS=10
URL_DOWNLOAD_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_BYTES=52428800
# Web sources above this many characters fail visibly instead of being truncated.
MAX_SOURCE_CHARS=1000000
# Only for the local demo server (scripts/run_demo_server.py). Keep false otherwise.
ALLOW_PRIVATE_HOSTS=false
